#!/bin/bash
# Clawputer launcher (CardputerZero): pick where Claude runs, optional RAM boost, then go.
#   g  chat GUI, Claude runs on this Cardputer
#   r  chat GUI, Claude runs on your PC over SSH
#   t  terminal, plain Claude Code (tmux, PageUp scrolls)
#   b  set up the optional RAM boost (asks for your password once)
SHARE=/usr/share/clawputer
CONF="$HOME/.config/clawputer"; mkdir -p "$CONF"
GUI="$SHARE/clawputer_gui.py"
WARN="$CONF/esc_warning"
BOOST=/usr/local/sbin/clawputer-boost
BOOTMODE=/usr/local/sbin/clawputer-bootmode
CLAUDE="$HOME/.local/bin/claude"; [ -x "$CLAUDE" ] || CLAUDE=$(command -v claude || echo "$CLAUDE")
TMUX_SOCK=clawputer

gpu_mb(){ vcgencmd get_mem gpu 2>/dev/null | tr -dc 0-9; }
boost_ok(){ [ -x "$BOOST" ] && sudo -n -l "$BOOST" on >/dev/null 2>&1; }
flush_keys(){ while read -rsn1 -t 0.05 _; do :; done; }

show_warning(){
  [ -f "$WARN" ] || return 0
  clear; echo "heads up:"; cat "$WARN"; echo
  echo "next time use ctrl+q / /exit to quit,"
  echo "not holding esc."
  rm -f "$WARN"; read -rsn1 -t 20 -p "any key..." _; echo
}

LPID=
resume_launcher(){ [ -n "$LPID" ] && kill -CONT "$LPID" 2>/dev/null; LPID=; }

# full-screen gui with the launcher paused (its status bar would draw over it)
run_gui(){
  sleep 0.5; printf '\033[?25l'; clear
  PYTHONPATH="$SHARE" python3 "$GUI" "$@" < /dev/null 2>>"$CONF/gui.log" &
  local gp=$!
  LPID=$(pgrep -o -f M5CardputerZero-APPLaunch)
  if [ -n "$LPID" ]; then
    # safety net: unpause the launcher when the gui ends, even if this script is killed
    setsid bash -c "while [ -e /proc/$gp ] && ! grep -q '^State:.*Z' /proc/$gp/status 2>/dev/null; do sleep 1; done; kill -CONT $LPID" \
      >/dev/null 2>&1 < /dev/null &
    sleep 0.5; kill -STOP "$LPID" 2>/dev/null
  fi
  wait "$gp"
  resume_launcher
  printf '\033[?25h'; flush_keys
}

# ---------------- inside tmux (terminal mode) / after boost: run with lite mode ----------------
if [ "${CLAWPUTER_STAGE:-}" = run ]; then
  GUARD=; HUPPED=
  restore(){
    trap - EXIT HUP TERM INT
    resume_launcher; printf '\033[?25h'
    [ -n "$GUARD" ] && kill "$GUARD" 2>/dev/null
    if [ -n "${CLAWPUTER_BOOST:-}" ]; then
      echo "restoring..."
      systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber 2>/dev/null
      sudo -n "$BOOST" off
    fi
    if [ -n "$HUPPED" ]; then
      { echo "clawputer was force-closed (held esc)."
        [ -n "${CLAWPUTER_BOOST:-}" ] && echo "everything was put back."
        [ "$(gpu_mb)" -le 16 ] 2>/dev/null && echo "low gpu memory + camera off until a reboot."; } > "$WARN"
      exit 0
    fi
    if [ "$(gpu_mb)" -le 16 ] 2>/dev/null; then
      echo; echo "reboot back to normal?"; echo "(gives gpu memory back"; echo " + turns camera on) y/n"
      if read -rsn1 -t 30 k && { [ "$k" = y ] || [ "$k" = Y ]; }; then
        echo "rebooting..."; sudo -n "$BOOTMODE" exit; sleep 60
      else
        echo "staying in boost mode (low gpu memory + camera off till reboot)"; sleep 2
      fi
    fi
    exit 0
  }
  trap restore EXIT
  trap 'HUPPED=1; exit' HUP TERM

  if [ -n "${CLAWPUTER_BOOST:-}" ]; then
    echo "freeing ram..."
    systemctl --user stop xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr \
      xdg-document-portal xdg-permission-store mpris-proxy filter-chain 'gvfs-*' \
      wireplumber pipewire-pulse pipewire pipewire.socket pipewire-pulse.socket 2>/dev/null
    sudo -n "$BOOST" on
    ME=$$
    setsid bash -c "while [ -e /proc/$ME ] && ! grep -q '^State:.*Z' /proc/$ME/status 2>/dev/null; do sleep 2; done
      systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber
      sudo -n $BOOST off
      printf 'clawputer was force-closed.\neverything was put back.\n' > '$WARN'" >/dev/null 2>&1 < /dev/null &
    GUARD=$!
  fi
  free -m | awk '/Mem:/{print "ram free: "$7" MB"}'
  export DISABLE_AUTOUPDATER=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
  mkdir -p "$HOME/clawputer"; cd "$HOME/clawputer" || exit 1
  if [ "${CLAWPUTER_UI:-}" = gui ]; then
    run_gui "$@"
  else
    "$CLAUDE" "$@"
  fi
  exit 0
fi

# ---------------- menu ----------------
clear; echo "starting clawputer..."
show_warning
UIF="$CONF/ui"
UI=$(cat "$UIF" 2>/dev/null || echo gui)

# first run (no Claude Code / not signed in): the gui walks you through setup
if [ ! -x "$CLAUDE" ] || ! "$CLAUDE" auth status 2>/dev/null | grep -q '"loggedIn": *true'; then
  run_gui; exit 0
fi

while true; do
  clear
  echo "== Clawputer =="
  echo "g gui, runs on this cardputer"
  if [ -f "$CONF/remote.json" ]; then echo "r gui, runs on your pc (fast)"
  else echo "r gui on your pc (set up: F1 in gui)"; fi
  echo "t terminal (default claude code)"
  if boost_ok; then echo "  ram boost: on"; else echo "b set up ram boost (optional)"; fi
  echo "enter = $UI   q = quit"
  read -rsn1 k
  case "$k" in
    g|G) UI=gui;; r|R) UI=remote;; t|T) UI=terminal;; ""|$'\n') ;;
    b|B)
      clear
      echo "RAM boost: while Claude runs on the"
      echo "cardputer, pause the desktop, audio,"
      echo "printing etc, and optionally reboot"
      echo "with more RAM (camera off that boot)."
      echo "needs your password once."
      echo
      sudo "$SHARE/boost/enable-boost.sh" && echo "done." || echo "not enabled."
      read -rsn1 -t 10 -p "any key..." _; continue;;
    q|Q) clear; exit 0;;
    *) continue;;
  esac
  break
done
echo "$UI" > "$UIF"

if [ "$UI" = remote ]; then
  if [ ! -f "$CONF/remote.json" ]; then
    clear; echo "no PC set up yet."; echo "open the gui (g), F1 > remote pc setup."
    read -rsn1 -t 20 -p "any key..." _; exit 0
  fi
  export CLAWPUTER_REMOTE=1 CLAUDE_REMOTE=1
  run_gui; exit 0
fi

# local: optional boost (pause stuff + one-boot gpu trick)
if boost_ok; then
  export CLAWPUTER_BOOST=1
  if [ "$(gpu_mb)" -gt 16 ] 2>/dev/null; then
    clear
    echo "== RAM boost =="
    echo "reboot to move gpu memory to ram?"
    echo "(+~112MB, camera off till next reboot)"
    echo
    echo "y reboot now (open Clawputer after)"
    echo "n just go"
    read -rsn1 k
    if [ "$k" = y ] || [ "$k" = Y ]; then
      echo; echo "rebooting..."; sleep 1; sudo -n "$BOOTMODE" enter; sleep 60; exit 0
    fi
  fi
fi

export CLAWPUTER_STAGE=run
if [ "$UI" = terminal ]; then
  export CLAWPUTER_UI=terminal
  exec tmux -L "$TMUX_SOCK" -f "$SHARE/tmux.conf" new-session -A -s clawputer "$0" "$@"
fi
export CLAWPUTER_UI=gui
exec "$0" "$@"
