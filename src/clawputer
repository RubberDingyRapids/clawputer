#!/bin/bash
# Clawputer launcher (CardputerZero).
# APPLaunch starts this as a normal (non-terminal) app: it stops drawing, hands us the screen
# and waits until this script exits. We show the GUI mode screen (first run: install Claude
# Code + sign in), then start the chat as a small systemd user service (clawputer-chat).
# Esc on an empty message box minimises the chat: it lets go of the screen and keyboard, this
# script exits and the launcher comes back, while the chat keeps going in the background.
# Opening Clawputer again wakes it up, straight back into the chat.
SHARE=/usr/share/clawputer
CONF="$HOME/.config/clawputer"; mkdir -p "$CONF"
GUI="$SHARE/clawputer_gui.py"
UNIT=clawputer-chat
STATE="$CONF/gui.state"    # the chat writes shown / hidden
BOOST=/usr/local/sbin/clawputer-boost
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
echo $$ > "$CONF/gui.ctl"  # the chat on screen checks we're still here

boost_ok(){ [ -x "$BOOST" ] && sudo -n -l "$BOOST" on >/dev/null 2>&1; }
chat_running(){ systemctl --user is-active --quiet "$UNIT"; }
chat_pid(){ systemctl --user show -p MainPID --value "$UNIT" 2>/dev/null; }
gui_state(){ local st=; { read -r st < "$STATE"; } 2>/dev/null; echo "$st"; }

# stay here (so the launcher keeps out of the way) while the chat is on screen
wait_chat(){
  local p=$1
  while [ -e "/proc/$p" ] && [ "$(gui_state)" != hidden ]; do sleep 0.3; done
}

# ---- a minimised chat? wake it up ----
if chat_running; then
  P=$(chat_pid)
  if [ "$(gui_state)" = hidden ] && [ -n "$P" ] && [ "$P" != 0 ]; then
    echo waking > "$STATE"
    kill -USR1 "$P"
    wait_chat "$P"
    exit 0
  fi
  # running but not minimised (stuck, or still closing): close it properly, start fresh
  systemctl --user stop "$UNIT"
fi
systemctl --user reset-failed "$UNIT" >/dev/null 2>&1

# ---- mode screen (the GUI does the install / sign-in / ram boost setup itself) ----
rm -f "$CONF/choice"
PYTHONPATH="$SHARE" python3 "$GUI" --menu < /dev/null >/dev/null 2>>"$CONF/gui.log"
CHOICE=$(cat "$CONF/choice" 2>/dev/null || echo quit)

ENV=(-E CLAWPUTER_HIDE=1 -E CLAWPUTER_CHECKED=1 -E PYTHONPATH="$SHARE" -E PATH="$PATH"
     -E LANG="${LANG:-C.UTF-8}" -E DISABLE_AUTOUPDATER=1 -E CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)
[ -n "${APPLAUNCH_LINUX_FBDEV_DEVICE:-}" ] && ENV+=(-E APPLAUNCH_LINUX_FBDEV_DEVICE="$APPLAUNCH_LINUX_FBDEV_DEVICE")
case "$CHOICE" in
  pc)            ENV+=(-E CLAWPUTER_REMOTE=1 -E CLAUDE_REMOTE=1);;
  local)         boost_ok && ENV+=(-E CLAWPUTER_BOOST=1);;
  local-noboost) ;;
  *)             exit 0;;
esac

# ---- the chat, as a user service so it can outlive this script when minimised ----
# the last chat may still be closing (putting the ram boost back): wait for it, or the new one
# can't start under the same name
for _ in $(seq 1 120); do
  st=$(systemctl --user show -p ActiveState --value "$UNIT" 2>/dev/null)
  case "$st" in active|deactivating|activating|reloading) sleep 0.25;; *) break;; esac
done
systemctl --user reset-failed "$UNIT" >/dev/null 2>&1
# OOMScoreAdjust: if memory ever runs out, the kernel picks claude, not the launcher.
# ExecStopPost: however the chat ends (quit, crash, killed), the ram boost gets put back.
mkdir -p "$HOME/clawputer"
rm -f "$STATE"
systemd-run --user --quiet --collect --unit="$UNIT" --working-directory="$HOME/clawputer" \
  -p OOMScoreAdjust=500 -p KillMode=mixed -p TimeoutStopSec=20 \
  -p StandardError="append:$CONF/gui.log" -p ExecStopPost="$SHARE/clawputer-cleanup" \
  "${ENV[@]}" python3 "$GUI" || exit 1
P=
for _ in $(seq 1 20); do P=$(chat_pid); [ -n "$P" ] && [ "$P" != 0 ] && break; sleep 0.1; done
[ -n "$P" ] && [ "$P" != 0 ] && wait_chat "$P"
exit 0
